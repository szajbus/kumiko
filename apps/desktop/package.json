{
  "name": "@kumiko/desktop",
  "productName": "Kumiko",
  "version": "0.1.0",
  "private": true,
  "description": "Creates, starts, stops and deletes Lima sandboxes.",
  "author": "Michał Szajbe",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "dist:mac-arm64-app": "node build.mjs && electron-builder --mac dir --arm64 --publish never",
    "dist:linux": "node build.mjs && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@kumiko/server": "*",
    "@kumiko/shared": "*"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "dev.kumiko.app",
    "productName": "Kumiko",
    "directories": { "output": "release" },
    "files": ["out/**", "assets/icon/png/512x512.png", "package.json", "!node_modules/**"],
    "extraResources": [{ "from": "../../packages/web/dist", "to": "web" }],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon/macos/icon.icns"
    },
    "win": { "icon": "assets/icon/icon.ico" },
    "linux": { "target": "dir", "icon": "assets/icon/png" }
  }
}
